// Fototeca platform — data model (REFERENCE / ERD, not the live schema).
//
// The actual database is created and queried through plain SQL instead:
// see db/schema.sql (DDL) and src/lib/repo/*.ts (queries via `pg`). Reason:
// Prisma's classic CLI needs to download a native query-engine binary at
// `generate`/`migrate` time, which is a fragile dependency for a self-hosted
// server that may have limited or no internet access — exactly the
// deployment target here. This file is kept because it documents the model
// clearly; keep it in sync with db/schema.sql by hand when either changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Content managed from the admin panel ---------------------------------

model Banner {
  id          String   @id @default(cuid())
  tag         String
  title       String
  description String
  primaryCta  String
  secondaryCta String
  imageUrl    String?
  isPublished Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  tag         String
  title       String
  excerpt     String
  content     String   @db.Text
  coverImageUrl String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model CatalogItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  priceFrom   Int // тенге
  coverImageUrl String?
  gradientFrom String @default("oklch(84% 0.05 40)")
  gradientTo   String @default("oklch(64% 0.07 32)")
  requiresUpload Boolean @default(true)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  formats     CatalogFormat[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A concrete orderable variant of a catalog item, e.g. "20x20 см, 18 разворотов"
model CatalogFormat {
  id            String   @id @default(cuid())
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  catalogItemId String
  name          String // "20×20 см"
  widthPx       Int
  heightPx      Int
  pricePerSpread Int
  minSpreads    Int      @default(1)
  coverOptions  CoverOption[]
}

// Хит2 / Тканевая / Экокожа / Комби — single-level choice per format
model CoverOption {
  id              String   @id @default(cuid())
  catalogFormat   CatalogFormat @relation(fields: [catalogFormatId], references: [id])
  catalogFormatId String
  name            String // "Хит2" | "Тканевая" | "Экокожа" | "Комби"
  priceModifier   Int      @default(0)
  swatchImageUrl  String?
}

// --- Clients & orders (skeleton — filled out in the order-configurator phase) ---

model Client {
  id        String   @id @default(cuid())
  fullName  String
  phone     String   @unique
  email     String?
  orders    Order[]
  legacyOrders LegacyOrder[]
  createdAt DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  number      String   @unique // e.g. "2026040924", migrated from the legacy journal
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  status      OrderStatus @default(AWAITING_PAYMENT)
  totalAmount Int
  legacyOrderId String? @unique // reference to the source record during migration
  items       OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OrderStatus {
  AWAITING_PAYMENT
  AWAITING_FILES
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

// One row per configured item in an order — tracked separately because
// production (claude/audit-sistemy-zakazov.md §5) follows each item through
// its own stage, with its own uploaded files.
model OrderItem {
  id              String   @id @default(cuid())
  order           Order    @relation(fields: [orderId], references: [id])
  orderId         String
  catalogItem     CatalogItem @relation(fields: [catalogItemId], references: [id])
  catalogItemId   String
  catalogFormat   CatalogFormat @relation(fields: [catalogFormatId], references: [id])
  catalogFormatId String
  coverOption     CoverOption @relation(fields: [coverOptionId], references: [id])
  coverOptionId   String
  spreads         Int
  endpapers       Boolean  @default(false)
  packaging       Boolean  @default(false)
  express         Boolean  @default(false)
  price           Int
  uploadDraftId   String?
  productionStage ProductionStage @default(PRINTING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ProductionStage {
  PRINTING
  ASSEMBLY
  COVER
  DONE
}

// Archive of orders imported from the old XAF system (zakaz.fototeca.kz).
// Deliberately separate from Order/OrderItem — the legacy journal is
// free-form (one text field for delivery info, product names as plain
// text, no references to catalog items/formats/cover options), so this
// preserves each legacy record as-is rather than forcing a structured fit.
model LegacyOrder {
  id             String   @id @default(cuid())
  legacyNumber   String   @unique
  legacyDate     DateTime?
  client         Client?  @relation(fields: [clientId], references: [id])
  clientId       String?
  department     String?
  contractorName String?
  cellNumber     String?
  orderAmount    Decimal?
  amountToPay    Decimal?
  amountPaid     Decimal?
  email          String?
  executor       String?
  dueDate        DateTime?
  deliveryInfo   String?
  kaspiNumber    String?
  holdReason     String?
  rawStatus      String?
  lineItems      Json?
  importedAt     DateTime @default(now())
}
