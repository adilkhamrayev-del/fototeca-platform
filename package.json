{
  "name": "fototeca-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:apply-schema": "node --env-file-if-exists=.env --experimental-strip-types --experimental-transform-types scripts/apply-schema.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types --experimental-transform-types scripts/seed.ts",
    "db:migrate-legacy": "node --env-file-if-exists=.env --experimental-strip-types --experimental-transform-types scripts/migrate-legacy-orders.ts",
    "db:migrate-legacy-contractors": "node --env-file-if-exists=.env --experimental-strip-types --experimental-transform-types scripts/migrate-legacy-contractors.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
